---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'System Design, Step by Step';
const {
  title,
  description = 'Reference system designs explained step by step, with interactive diagrams and the trade-off behind every choice.',
} = Astro.props;
const pageTitle = title ? `${title} · ${site}` : site;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pablo Magnaghi" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand">
          <span class="long">System Design, Step by Step</span>
          <span class="short">System Design</span>
        </a>
        <nav aria-label="Main">
          <a href="/#designs">Designs</a>
          <a href="/#framework">Framework</a>
          <a href="https://pablomagnaghi.com" class="author-link">
            Pablo Magnaghi
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>
          © {new Date().getFullYear()} <a href="https://pablomagnaghi.com">Pablo Magnaghi</a>
        </span>
        <span>
          <a href="https://github.com/pablomagnaghi/system-design">Source on GitHub</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
  }
  nav {
    display: flex;
    gap: 20px;
    font-size: 0.95rem;
  }
  nav a {
    color: var(--text-muted);
  }
  nav a:hover {
    color: var(--text);
  }
  nav .author-link {
    color: var(--accent);
    font-weight: 600;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .site-footer .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
  .brand .short {
    display: none;
  }
  @media (max-width: 640px) {
    nav a:not(.author-link) {
      display: none;
    }
    .brand .long {
      display: none;
    }
    .brand .short {
      display: inline;
    }
  }
</style>
