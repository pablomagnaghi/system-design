---
import type { GetStaticPaths } from 'astro';
import { designs, type Design } from '../../content';
import Walkthrough from '../../components/Walkthrough';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { relatedAfter } from '../../lib/related-designs';

export const getStaticPaths = (() =>
  designs.map((design) => ({
    params: { slug: design.slug },
    props: { design },
  }))) satisfies GetStaticPaths;

interface Props {
  design: Design;
}

const { design } = Astro.props;
const others = relatedAfter(designs, design.slug);
---

<BaseLayout title={design.title} description={design.summary}>
  <article class="container">
    <a href="/#designs" class="back">
      ← All designs
    </a>
    <p class="eyebrow">{design.difficulty} · reference design</p>
    <h1>{design.title}</h1>
    <p class="summary">{design.summary}</p>

    <nav class="toc" aria-label="Sections">
      <a href="#requirements">1 · Requirements</a>
      <a href="#entities">2 · Core entities</a>
      <a href="#api">3 · API</a>
      <a href="#data-flow">4 · Data flow</a>
      <a href="#high-level">5 · High-level design</a>
      <a href="#deep-dives">6 · Deep dives</a>
      {design.guarantees && <a href="#guarantees">Guarantees</a>}
      {design.failures && design.failures.length > 0 && <a href="#failures">Failures</a>}
      {design.capacity && <a href="#capacity">Capacity</a>}
      {design.evolution && <a href="#evolution">Evolution</a>}
    </nav>

    <section id="requirements">
      <h2>
        <span class="step">1</span> Requirements
      </h2>
      <div class="columns">
        <div>
          <h3>Functional</h3>
          <ul>
            {design.requirements.functional.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Non-functional</h3>
          <ul>
            {design.requirements.nonFunctional.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="muted small">
        <strong>Out of scope:</strong> {design.requirements.outOfScope.join(' ')}
      </p>
    </section>

    <section id="entities">
      <h2>
        <span class="step">2</span> Core entities
      </h2>
      <dl class="entities">
        {design.entities.map((entity) => (
          <div class="card">
            <dt>{entity.name}</dt>
            <dd>{entity.description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="api">
      <h2>
        <span class="step">3</span> API
      </h2>
      <div class="endpoints">
        {design.api.map((endpoint) => (
          <div class="endpoint">
            <code>
              <span class="method">{endpoint.method}</span> {endpoint.path}
            </code>
            <p class="muted">{endpoint.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="data-flow">
      <h2>
        <span class="step">4</span> Data flow
      </h2>
      <ol class="flow">
        {design.dataFlow.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </section>

    <section id="high-level">
      <h2>
        <span class="step">5</span> High-level design
      </h2>
      <p class="muted">
        Press play to follow one request through the system. Every step explains what happens and
        the trade-off behind the choice.
      </p>
      <Walkthrough client:visible walkthrough={design.highLevel} />
    </section>

    <section id="deep-dives">
      <h2>
        <span class="step">6</span> Deep dives
      </h2>
      {design.deepDives.map((dive) => (
        <div class="dive">
          <h3>{dive.question}</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Option</th>
                  <th scope="col">Gives</th>
                  <th scope="col">Costs</th>
                </tr>
              </thead>
              <tbody>
                {dive.options.map((option) => (
                  <tr>
                    <th scope="row">{option.name}</th>
                    <td>{option.pros}</td>
                    <td>{option.cons}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="choice">
            <strong>Choice.</strong> {dive.choice}
          </p>
        </div>
      ))}
    </section>

    {design.guarantees && (
      <section id="guarantees">
        <h2>Guarantees</h2>
        <p class="muted">What this design promises, what that depends on, and what it does not.</p>
        <dl class="pairs">
          {design.guarantees.provides.map((item) => (
            <div class="card">
              <dt>{item.property}</dt>
              <dd>{item.promise}</dd>
            </div>
          ))}
        </dl>
        <div class="columns">
          <div>
            <h3>Assumes</h3>
            <ul>
              {design.guarantees.assumes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Does not guarantee</h3>
            <ul>
              {design.guarantees.doesNotGuarantee.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {design.failures && design.failures.length > 0 && (
      <section id="failures">
        <h2>Failure scenarios and recovery</h2>
        <p class="muted">What happens off the happy path, how it is noticed and how it heals.</p>
        {design.failures.map((failure) => (
          <div class="card failure">
            <h3>{failure.scenario}</h3>
            <dl>
              <dt>Impact</dt>
              <dd>{failure.impact}</dd>
              <dt>Detection</dt>
              <dd>{failure.detection}</dd>
              <dt>Recovery</dt>
              <dd>{failure.recovery}</dd>
            </dl>
          </div>
        ))}
      </section>
    )}

    {design.capacity && (
      <section id="capacity">
        <h2>Capacity planning</h2>
        <p class="muted">
          Back-of-the-envelope numbers. They are illustrative orders of magnitude, used to justify
          decisions, not measurements.
        </p>
        <h3>Assumptions</h3>
        <ul>
          {design.capacity.assumptions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Estimate</th>
                <th>Value</th>
                <th>How</th>
              </tr>
            </thead>
            <tbody>
              {design.capacity.estimates.map((estimate) => (
                <tr>
                  <th>{estimate.label}</th>
                  <td class="value">{estimate.value}</td>
                  <td>{estimate.math}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <h3>What the numbers force</h3>
        <ul>
          {design.capacity.implications.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    {design.evolution && (
      <section id="evolution">
        <h2>How it evolves</h2>
        <dl class="evolution">
          <dt>Start simple</dt>
          <dd>{design.evolution.mvp}</dd>
          <dt>First bottleneck</dt>
          <dd>{design.evolution.firstBottleneck}</dd>
        </dl>
        <div class="columns">
          <div>
            <h3>At 10x and 100x</h3>
            <ul>
              {design.evolution.atScale.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Avoided on purpose</h3>
            <ul>
              {design.evolution.avoided.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <section class="wrap-up">
      <h2>In one sentence</h2>
      <p>{design.wrapUp}</p>
    </section>

    <section class="more" aria-labelledby="more-title" data-carousel>
      <div class="more-head">
        <h2 id="more-title">More designs</h2>
        <div class="more-controls">
          <button type="button" class="more-button" data-prev aria-label="Previous designs">
            ←
          </button>
          <button type="button" class="more-button" data-next aria-label="Next designs">
            →
          </button>
        </div>
      </div>
      <ul class="more-track" data-track>
        {others.map((other) => (
          <li>
            <a class="card more-card" href={`/designs/${other.slug}/`}>
              <span class="more-badge">{other.difficulty}</span>
              <span class="more-name">{other.title}</span>
              <span class="more-summary">{other.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  article {
    padding-top: 48px;
    padding-bottom: 80px;
    max-width: 960px;
  }
  .back {
    display: inline-block;
    margin-bottom: 24px;
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin: 0 0 16px;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 0 0 24px;
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }
  .toc a {
    font-size: 0.85rem;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
  }
  .toc a:hover {
    text-decoration: none;
    color: var(--accent);
    border-color: var(--accent);
  }
  section {
    scroll-margin-top: 80px;
    padding: 0;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 56px 0 16px;
    font-size: 1.5rem;
  }
  .step {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.95rem;
  }
  h3 {
    font-size: 1.05rem;
    margin: 0 0 8px;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 24px;
  }
  ul,
  .flow {
    margin: 0;
    padding-left: 20px;
  }
  li {
    margin-bottom: 6px;
  }
  .small {
    font-size: 0.92rem;
    margin-top: 16px;
  }
  .entities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 12px;
    margin: 0;
  }
  .entities dt {
    font-weight: 700;
  }
  .entities dd {
    margin: 4px 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .endpoints {
    display: grid;
    gap: 12px;
  }
  .endpoint code {
    display: block;
    font-family: var(--mono);
    font-size: 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .method {
    color: var(--accent);
    font-weight: 700;
  }
  .endpoint p {
    margin: 6px 0 0;
    font-size: 0.95rem;
  }
  .dive {
    margin-bottom: 32px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  tbody th {
    width: 28%;
  }
  td {
    color: var(--text-muted);
  }
  .choice {
    margin-top: 12px;
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
  }
  .pairs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 12px;
    margin: 16px 0;
  }
  .pairs dt,
  .failure dt,
  .evolution dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .pairs dd,
  .failure dd,
  .evolution dd {
    margin: 4px 0 0;
  }
  .failure {
    margin-bottom: 12px;
  }
  .failure h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
  }
  .failure dl {
    margin: 0;
  }
  .failure dd,
  .evolution dd {
    margin-bottom: 10px;
  }
  .value {
    font-family: var(--mono);
    white-space: nowrap;
  }
  .wrap-up p {
    font-size: 1.1rem;
  }
  .more {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .more-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .more-head h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .more-controls {
    display: flex;
    gap: 8px;
  }
  .more-button {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .more-button:hover,
  .more-button:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .more-track {
    list-style: none;
    margin: 0;
    padding: 4px 2px 12px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(280px, 80%);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
  }
  .more-track li {
    scroll-snap-align: start;
    display: flex;
  }
  .more-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    padding: 20px;
    color: var(--text);
  }
  .more-card:hover,
  .more-card:focus-visible {
    text-decoration: none;
    border-color: var(--accent);
  }
  .more-badge {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .more-name {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .more-summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* While drifting, snapping and smooth scrolling would fight the per-frame movement. */
  .more-track.drifting {
    scroll-snap-type: none;
    scroll-behavior: auto;
    scrollbar-width: none;
  }
  .more-track.drifting::-webkit-scrollbar {
    display: none;
  }
  .more-track.drifting li {
    will-change: transform, opacity;
  }
  .more-button {
    transition:
      transform 120ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }
  .more-button:active {
    transform: scale(0.92);
  }
  @media (prefers-reduced-motion: reduce) {
    .more-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { easeOutCubic, visibleFraction, wrapOffset } from '../../lib/related-designs';

  // Pixels per second of the continuous drift: slow enough to read, fast enough to notice.
  const SPEED = 45;
  // How long the drift waits after someone scrolls, drags or presses an arrow.
  const HOLD_MS = 4000;
  // Duration of the glide an arrow press starts.
  const GLIDE_MS = 420;

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) continue;
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const page = () => track.clientWidth;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Without motion the strip stays still and the arrows page through it.
      prev?.addEventListener('click', () => track.scrollBy({ left: -page() }));
      next?.addEventListener('click', () => track.scrollBy({ left: page() }));
      continue;
    }

    // Render the cards twice so the strip loops forever. The copies are hidden from screen readers
    // and from the tab order, so keyboard and assistive tech see each design once.
    for (const item of [...track.children]) {
      const copy = item.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      copy.querySelectorAll('a').forEach((link) => link.setAttribute('tabindex', '-1'));
      track.append(copy);
    }
    track.classList.add('drifting');
    const loop = () => track.scrollWidth / 2;
    const items = [...track.children] as HTMLElement[];

    // Cards entering or leaving the window shrink and fade with how much of them is visible, so the
    // edge reads as motion instead of a hard cut.
    const shapeCards = () => {
      const view = track.getBoundingClientRect();
      const boxes = items.map((item) => item.getBoundingClientRect());
      items.forEach((item, i) => {
        const box = boxes[i];
        if (!box) return;
        const shown = visibleFraction(box.left, box.right, view.left, view.right);
        item.style.opacity = String(0.3 + 0.7 * shown);
        item.style.transform = `scale(${0.9 + 0.1 * shown})`;
      });
    };

    let position = track.scrollLeft;
    let hovered = false;
    let focused = false;
    let visible = false;
    let pausedUntil = 0;
    const holdOff = () => (pausedUntil = Date.now() + HOLD_MS);
    root.addEventListener('mouseenter', () => (hovered = true));
    root.addEventListener('mouseleave', () => (hovered = false));
    root.addEventListener('focusin', () => (focused = true));
    root.addEventListener('focusout', () => (focused = false));
    track.addEventListener('pointerdown', holdOff);
    track.addEventListener('wheel', holdOff, { passive: true });
    track.addEventListener('touchstart', holdOff, { passive: true });
    new IntersectionObserver(([entry]) => (visible = entry?.isIntersecting ?? false)).observe(root);

    // A manual scroll moves the strip; keep it inside one copy and let the drift resume from there.
    track.addEventListener(
      'scroll',
      () => {
        if (Math.abs(track.scrollLeft - position) < 2) return;
        const wrapped = wrapOffset(track.scrollLeft, loop());
        if (Math.abs(wrapped - track.scrollLeft) > 1 && Date.now() >= pausedUntil) {
          track.scrollLeft = wrapped;
        }
        position = wrapped;
      },
      { passive: true },
    );

    // The arrows glide one visible page, starting on the same frame as the press. Near either end,
    // jump to the matching spot in the other copy first, so there is always room to glide.
    let glideFrame = 0;
    const glide = (direction: 1 | -1) => {
      holdOff();
      cancelAnimationFrame(glideFrame);
      let start = track.scrollLeft;
      if (direction < 0 && start < page()) start += loop();
      if (direction > 0 && start + 2 * page() > track.scrollWidth) start -= loop();
      const distance = direction * page();
      // Count one frame as already elapsed, so the press moves the strip on this very frame.
      const began = performance.now() - 16;
      const step = (now: number) => {
        const progress = easeOutCubic((now - began) / GLIDE_MS);
        position = start + distance * progress;
        track.scrollLeft = position;
        if (progress < 1) glideFrame = requestAnimationFrame(step);
      };
      step(performance.now());
    };
    prev?.addEventListener('click', () => glide(-1));
    next?.addEventListener('click', () => glide(1));

    let last = performance.now();
    const tick = (now: number) => {
      const seconds = Math.min(now - last, 100) / 1000;
      last = now;
      const paused = !visible || hovered || focused || document.hidden || Date.now() < pausedUntil;
      if (!paused) {
        position = wrapOffset(position + SPEED * seconds, loop());
        track.scrollLeft = position;
      }
      shapeCards();
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
