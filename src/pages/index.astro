---
import { designs, framework } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Reference designs · interactive diagrams</p>
      <h1>
        System design,
        <br />
        step by step.
      </h1>
      <p class="lead">
        Classic system design problems worked through in the order of an interview. Each design has
        an animated diagram: press play to follow one request through the system, and read what
        happens at every step and the trade-off behind it.
      </p>
      <div class="actions">
        <a class="button primary" href="#designs">
          See the designs
        </a>
        <a class="button" href="#framework">
          How each design is built
        </a>
      </div>
    </div>
  </section>

  <section id="designs">
    <div class="container">
      <p class="eyebrow">Designs</p>
      <h2 class="section-title">Three problems, end to end</h2>
      <div class="cards">
        {designs.map((design) => (
          <a class="card design" href={`/designs/${design.slug}/`}>
            <span class="badge">{design.difficulty}</span>
            <h3>{design.title}</h3>
            <p class="muted">{design.summary}</p>
            <span class="cta">
              {design.highLevel.stages.length} steps · {design.deepDives.length} deep dives →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="framework">
    <div class="container">
      <p class="eyebrow">Framework</p>
      <h2 class="section-title">How each design is built</h2>
      <p class="section-lead">
        Every design follows the same six steps, the order that works best in a 45-minute interview:
        agree on the problem before drawing boxes, then spend the remaining time where the design is
        weakest.
      </p>
      <ol class="steps">
        {framework.map((item, index) => (
          <li>
            <span class="number">{index + 1}</span>
            <div>
              <h3>{item.step}</h3>
              <p class="muted">{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="note">
        These are generic reference designs written to explain trade-offs. They do not describe any
        company's production systems.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 88px 0 56px;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .lead {
    max-width: 640px;
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 0 0 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .button:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--surface);
  }
  #designs,
  #framework {
    padding: 64px 0;
    border-top: 1px solid var(--border);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .design {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
  }
  .design:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .design h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .design p {
    margin: 0;
  }
  .badge {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .cta {
    margin-top: auto;
    padding-top: 8px;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  .steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .number {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-family: var(--mono);
  }
  .steps h3 {
    margin: 2px 0 4px;
    font-size: 1.05rem;
  }
  .steps p {
    margin: 0;
  }
  .note {
    margin-top: 32px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
</style>
